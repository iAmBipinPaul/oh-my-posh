{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Folder }} | {{ .UserName }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "foreground": "#E2E8F0",
          "background": "#111827",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0",
          "template": " {{ if .WSL }}\ue712{{ else }}\ue70f{{ end }} "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#E2E8F0",
          "background": "#1F2937",
          "background_templates": [
            "{{ if .Root }}#F87171{{ end }}"
          ],
          "template": " {{ if .Root }}\uf0e7 ADMIN {{ else }}\uf2bd {{ end }}{{ .UserName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#111827",
          "background": "#60A5FA",
          "template": " \uf07c {{ .Path }} ",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_icon": "\uf07b",
            "home_icon": "\uf015"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#111827",
          "background": "#4ADE80",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FBBF24{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#FBBF24{{ end }}",
            "{{ if gt .Ahead 0 }}#38BDF8{{ end }}",
            "{{ if gt .Behind 0 }}#94A3B8{{ end }}"
          ],
          "template": " \ue725 {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \uf692 {{ .StashCount }}{{ end }} ",
          "options": {
            "fetch_status": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "diamond",
          "foreground": "#111827",
          "background": "#38BDF8",
          "leading_diamond": "\ue0b2",
          "template": " \uf017 {{ .CurrentDate | date \"Mon 3:04 PM\" }} "
        },
        {
          "type": "shell",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#E2E8F0",
          "background": "#334155",
          "template": " \u276f {{ .Name }} "
        },
        {
          "type": "sysinfo",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#E2E8F0",
          "background": "#475569",
          "template": " \uf538 {{ round .PhysicalPercentUsed .Precision }}% ",
          "options": {
            "precision": 0
          }
        },
        {
          "type": "battery",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#111827",
          "background": "#4ADE80",
          "background_templates": [
            "{{ if lt .Percentage 20 }}#F87171{{ end }}",
            "{{ if and (ge .Percentage 20) (lt .Percentage 50) }}#FBBF24{{ end }}"
          ],
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }} "
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#111827",
          "background": "#4ADE80",
          "template": " \ue718 {{ .Full }} "
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#111827",
          "background": "#60A5FA",
          "template": " \ue235 {{ .Full }} "
        },
        {
          "type": "go",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#111827",
          "background": "#38BDF8",
          "template": " \ue627 {{ .Full }} "
        },
        {
          "type": "dotnet",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#111827",
          "background": "#94A3B8",
          "template": " \ue77f {{ .Full }} "
        },
        {
          "type": "docker",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#111827",
          "background": "#38BDF8",
          "template": " \uf308 {{ .Context }} "
        },
        {
          "type": "kubectl",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#111827",
          "background": "#60A5FA",
          "template": " \ufd31 {{ .Context }}{{ if .Namespace }}:{{ .Namespace }}{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#111827",
          "background": "#FBBF24",
          "trailing_diamond": "\ue0b4",
          "template": " \uf252 {{ .FormattedMs }} ",
          "options": {
            "threshold": 500,
            "style": "roundrock"
          }
        },
        {
          "type": "copilot",
          "style": "plain",
          "template": "  \uec1e  {{ .Premium.Used }} ",
          "cache": {
            "duration": "5m",
            "strategy": "session"
          },
          "options": {
            "http_timeout": 1000
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#4ADE80",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#F87171{{ end }}"
          ],
          "template": "\u276f ",
          "options": {
            "always_enabled": true
          }
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "#475569",
    "background": "transparent",
    "template": "\u276f "
  },
  "secondary_prompt": {
    "foreground": "#94A3B8",
    "background": "transparent",
    "template": "\u276f\u276f "
  }
}
